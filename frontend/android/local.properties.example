# 이 파일을 local.properties 로 복사해 각자 값을 채운다. local.properties 는 Git 에서 제외된다.
# 경로 구분자는 / 를 쓴다.
sdk.dir=C:/Users/YOUR_NAME/AppData/Local/Android/Sdk

# VocalScope 엔진(FastAPI). 에뮬레이터에서 PC localhost = 10.0.2.2.
# 실기기는 `adb reverse tcp:8787 tcp:8787` 후 http://127.0.0.1:8787/ 로.
ENGINE_BASE_URL=http://10.0.2.2:8787/

# 앱 백엔드(Spring/MySQL, 예정). 아직 없으면 그대로 둔다.
API_BASE_URL=http://10.0.2.2:8080/api/v1/

# 추천 서버(ai/recommend-server, FastAPI 8788). 비워 두면 앱 안 로컬 계산(음역만)으로 동작한다.
# 서버를 켜고 시험할 때만: RECOMMEND_BASE_URL=http://10.0.2.2:8788/
RECOMMEND_BASE_URL=

# 소셜 로그인 키 (비어 있어도 빌드된다. 해당 기능만 동작하지 않음)
GOOGLE_WEB_CLIENT_ID=
KAKAO_NATIVE_APP_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Release 서명 (네 값이 모두 있을 때만 release signingConfig 가 만들어진다)
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
