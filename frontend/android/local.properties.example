# 이 파일을 local.properties 로 복사해 각자 값을 채운다. local.properties 는 Git 에서 제외된다.
# 경로 구분자는 / 를 쓴다.
sdk.dir=C:/Users/YOUR_NAME/AppData/Local/Android/Sdk

# 앱 백엔드(Spring/MySQL). 곡 카탈로그·연습 데이터·인증이 전부 여기서 온다 — 로컬 BE(bootRun) 또는 운영 https://j15b110.p.ssafy.io/api/v1/
# 실기기: `adb reverse tcp:8080 tcp:8080` 후 http://127.0.0.1:8080/api/v1/ (HTTP 는 10.0.2.2·127.0.0.1·localhost 만 허용)
API_BASE_URL=http://10.0.2.2:8080/api/v1/


# 소셜 로그인 키 (비어 있어도 빌드된다. 해당 기능만 동작하지 않음)
GOOGLE_WEB_CLIENT_ID=
KAKAO_NATIVE_APP_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Release 서명 (실제 키는 저장소 밖 보관. Jenkins에는 local.properties 대신 Credentials/환경변수 사용)
# 네 서명값·버전·명시적 HTTPS 주소가 없으면 Release 빌드는 실패한다. Debug 기본 동작은 유지.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
RELEASE_VERSION_CODE=
PREVIOUS_RELEASE_VERSION_CODE=
RELEASE_VERSION_NAME=

# PC model preview: explicit debug-only entry; production login remains the default.
GUIDED_RANGE_STANDALONE=false
RANGE_PREVIEW_BASE_URL=http://127.0.0.1:8789/

# Experimental continuous acoustic score: debug-only, off by default and always off in release.
# Deploy BE/AI v2 compatibility before sending opt-in debug results to a test account.
EXPERIMENTAL_CONTINUOUS_VOICE_QUALITY=false
