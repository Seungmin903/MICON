# VocalScope 환경변수 예시 — 복사해서 .env.local(프론트) 또는 셸 환경변수(엔진)로 사용
# cp .env.example .env.local

# [프론트] AI 모델 서버 주소. 로컬 개발 기본값은 http://127.0.0.1:8787
NEXT_PUBLIC_MODEL_API=http://127.0.0.1:8787

# [프론트] 배포 사이트 오리진 (OG 메타데이터 base URL). 로컬 개발 시 생략 가능
# NEXT_PUBLIC_SITE_URL=https://example.com

# [엔진] 보컬 분리 백엔드: melband(기본, 고품질) | htdemucs(빠름)
# 프론트가 아니라 model-server 실행 셸의 환경변수로 지정한다
# VOCALSCOPE_SEPARATOR=melband
