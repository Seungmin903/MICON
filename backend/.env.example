# S15P21B110-150: review template, NOT a runnable production environment.
# Values intentionally empty. Never fill this tracked example with real secrets.
# Copy to a Git-excluded .env OUTSIDE the repository before entering real values.
# Spring Boot does not automatically load .env. The approved launcher/Compose
# must explicitly inject variables. Do not start the app during the SQL hold:
# its existing Flyway configuration may migrate the connected DB on startup.
# Names mirror application.properties plus the documented AWS SDK-only settings.
# Formats, local fallbacks and proposed production rules:
# ../docs/operations/BACKEND_RUNTIME_CONTRACT.md

# JDBC MySQL URL; no password in URL. Confirm the private MySQL runtime/account.
DB_URL=
# Dedicated application account, not the local root fallback.
DB_USERNAME=
DB_PASSWORD=
# Unique random signing secret: at least 32 UTF-8 bytes (not an SSH/APK key).
JWT_SECRET=

# Google Sign-In ID 토큰 검증용 OAuth 2.0 Web client ID. Android의
# GOOGLE_WEB_CLIENT_ID와 같은 값이며, secret이 아니다.
GOOGLE_WEB_CLIENT_ID=
# Google 공개 키 주소. 기본값을 쓰면 설정할 필요 없다.
GOOGLE_JWK_SET_URI=

# Metadata-only access logs. Optional: INFO / true / 1000 when omitted.
ACCESS_LOG_LEVEL=
DB_ACCESS_LOG_ENABLED=
DB_ACCESS_SLOW_QUERY_MS=

# SMTP provider settings; authentication/TLS policy must be reviewed together.
# MAIL_FROM: approved sender address. MAIL_PORT: integer 1..65535.
# MAIL_SMTP_AUTH and MAIL_STARTTLS: true or false, never silently use local defaults.
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_STARTTLS=

# AI service and multipart request limits. Blank entries must be filled or omitted
# deliberately in the actual launcher; empty values do not mean use the default.
AI_SERVICE_TOKEN=
AI_VOICE_ANALYSIS_ENABLED=
AI_ARTIST_SEARCH_ENABLED=
AI_VOICE_ANALYSIS_CONTRACT_VERSION=
AI_VOICE_ANALYSIS_GUIDE_VERSION=
AI_VOICE_ANALYSIS_DOWNLOAD_URL_TTL=
AI_VOICE_ANALYSIS_MAX_FILE_BYTES=
AI_VOICE_ANALYSIS_CONNECT_TIMEOUT=
AI_VOICE_ANALYSIS_READ_TIMEOUT=
AI_VOICE_ANALYSIS_MAX_WAIT=
AI_VOICE_ANALYSIS_TIMEOUT_CHECK_INTERVAL=
AI_SONG_FIT_ENABLED=
AI_RECOMMENDATION_BASE_URL=
AI_RECOMMENDATION_ENABLED=
AI_RECOMMENDATION_SERVICE_TOKEN=
AI_RECOMMENDATION_CONNECT_TIMEOUT=
AI_RECOMMENDATION_READ_TIMEOUT=
AI_RECOMMENDATION_POLLING_ENABLED=
AI_RECOMMENDATION_POLL_INTERVAL=
AI_RECOMMENDATION_POLL_INITIAL_DELAY=
AI_RECOMMENDATION_RECOVERY_INTERVAL=
AI_RECOMMENDATION_RECOVERY_INITIAL_DELAY=
VOICE_ANALYSIS_REQUEST_MAX_SIZE=

# Personal-account private S3, accessed from the SSAFY backend server.
# Recommended values and provisioning status: ../docs/operations/S3_VOICE_STORAGE.md
VOICE_STORAGE_BUCKET=
VOICE_STORAGE_REGION=
VOICE_STORAGE_PREFIX=
VOICE_STORAGE_PLAYBACK_URL_TTL=
VOICE_STORAGE_MAX_FILE_BYTES=
VOICE_STORAGE_DELETION_RETRY_INTERVAL=
CATALOG_MEDIA_ALLOWED_PREFIX=
CATALOG_MEDIA_DOWNLOAD_URL_TTL=
SONG_PREVIEW_OBJECT_PREFIX=
SONG_PREVIEW_DOWNLOAD_URL_TTL=

VOICE_DATA_POLICY_VERSION=
VOICE_DATA_COLLECTION_PURPOSE=
VOICE_DATA_RETENTION_PERIOD=
VOICE_DATA_DELETION_POLICY=

# AWS SDK-only settings, not Spring properties. Read-only credentials file outside
# the repository/image; AWS profile is separate from Spring profile. Never add keys.
# Container path /run/secrets/aws_credentials; profile micon-backend; metadata true
# means AWS_EC2_METADATA_DISABLED=true (prevents SSAFY instance-role fallback).
AWS_SHARED_CREDENTIALS_FILE=
AWS_PROFILE=
AWS_EC2_METADATA_DISABLED=
