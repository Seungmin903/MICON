{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAssignedCatalogOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "catalog/<OWNER>/",
            "catalog/<OWNER>/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadAssignedCatalogForRetryVerification",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/catalog/<OWNER>/*"
    },
    {
      "Sid": "CreateAssignedImmutableObjects",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/catalog/<OWNER>/*",
      "Condition": {
        "Null": {
          "s3:if-none-match": "false"
        },
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "DenyNonConditionalWrites",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/catalog/<OWNER>/*",
      "Condition": {
        "Null": {
          "s3:if-none-match": "true"
        }
      }
    },
    {
      "Sid": "DenyCatalogDeletion",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/catalog/<OWNER>/*"
    }
  ]
}
