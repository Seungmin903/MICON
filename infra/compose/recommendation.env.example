# Non-secret runtime settings for infra/compose/recommendation.compose.yml.
# Copy to /etc/micon/runtime/recommendation.env and keep it root-owned mode 0600.
MICON_BE_BASE_URL=http://backend:8080
MICON_BE_CALLBACK_URL=http://backend:8080/callbacks/voice-analysis-components
RECOMMEND_CONCURRENCY=1
RECOMMEND_AUDIO_TTL_SECONDS=3600
RECOMMEND_AUDIO_HARD_TTL_SECONDS=86400
