# Non-secret runtime settings. Copy outside the repository to
# /etc/micon/runtime/backend.env and keep it root-owned mode 0600.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
ACCESS_LOG_LEVEL=INFO
DB_ACCESS_LOG_ENABLED=true
DB_ACCESS_SLOW_QUERY_MS=1000
DB_URL=jdbc:mysql://mysql:3306/micon?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=micon_app
MAIL_FROM=no-reply@micon.local
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
AI_VOICE_ANALYSIS_ENABLED=false
# AI 음색 분석 완료 후 닮은 가수 검색을 자동으로 실행한다.
AI_ARTIST_SEARCH_ENABLED=true
# Must match the AI artist-search callback modelVersion.
AI_ARTIST_SEARCH_SCORING_VERSION=ecapa-singer-byol-absolute-fusion-v3
AI_VOICE_ANALYSIS_CONTRACT_VERSION=v1
AI_VOICE_ANALYSIS_GUIDE_VERSION=v1
AI_VOICE_ANALYSIS_DOWNLOAD_URL_TTL=30m
AI_VOICE_ANALYSIS_MAX_FILE_BYTES=262144000
AI_VOICE_ANALYSIS_CONNECT_TIMEOUT=3s
AI_VOICE_ANALYSIS_READ_TIMEOUT=30s
AI_VOICE_ANALYSIS_MAX_WAIT=10m
AI_VOICE_ANALYSIS_TIMEOUT_CHECK_INTERVAL=1m
AI_SONG_FIT_ENABLED=false
AI_RECOMMENDATION_BASE_URL=http://micon-recommendation:8788
AI_RECOMMENDATION_ENABLED=false
AI_RECOMMENDATION_CONNECT_TIMEOUT=3s
AI_RECOMMENDATION_READ_TIMEOUT=30s
# Set to shelves-v6-stability-soft-score only after the matching BE + AI rollout.
AI_RECOMMENDATION_REQUIRED_SHELVES_VERSION=
AI_RECOMMENDATION_POLLING_ENABLED=false
AI_RECOMMENDATION_POLL_INTERVAL=5s
AI_RECOMMENDATION_POLL_INITIAL_DELAY=10s
AI_RECOMMENDATION_POLL_MAX_CONCURRENT=4
AI_RECOMMENDATION_DISPATCH_RETRY_INTERVAL=2s
AI_RECOMMENDATION_DISPATCH_RETRY_INITIAL_DELAY=5s
AI_RECOMMENDATION_RECOVERY_INTERVAL=1m
AI_RECOMMENDATION_RECOVERY_INITIAL_DELAY=10s
SCHEDULED_TASK_POOL_SIZE=4
VOICE_ANALYSIS_REQUEST_MAX_SIZE=25MB
VOICE_STORAGE_BUCKET=micon-b110-prod-apne2-20260909
VOICE_STORAGE_REGION=ap-northeast-2
VOICE_STORAGE_PREFIX=voice-recordings
VOICE_STORAGE_PLAYBACK_URL_TTL=10m
VOICE_STORAGE_MAX_FILE_BYTES=26214400
VOICE_STORAGE_DELETION_RETRY_INTERVAL=30s
CATALOG_MEDIA_ALLOWED_PREFIX=catalog/정영주/section-384-v1/vocals/
CATALOG_MEDIA_DOWNLOAD_URL_TTL=10m
SONG_PREVIEW_OBJECT_PREFIX=catalog/정다운/source-preview-pilot-20260922/
SONG_PREVIEW_DOWNLOAD_URL_TTL=10m
VOICE_DATA_POLICY_VERSION=UNCONFIRMED
VOICE_DATA_COLLECTION_PURPOSE=사용자의 음역·음색 분석과 노래 연습 결과 제공
VOICE_DATA_RETENTION_PERIOD=정책 확정 전
VOICE_DATA_DELETION_POLICY=사용자는 저장된 녹음과 음성 분석 데이터를 개별 또는 전체 삭제할 수 있습니다. 원본 녹음 저장이 꺼져 있으면 분석 완료 후 원본 녹음을 삭제합니다.
