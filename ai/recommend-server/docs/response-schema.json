{
  "$defs": {
    "Algorithm": {
      "additionalProperties": true,
      "description": "알려지지 않은 필드는 통과.",
      "properties": {
        "scoring_version": {
          "title": "Scoring Version",
          "type": "string"
        },
        "shelves_version": {
          "title": "Shelves Version",
          "type": "string"
        },
        "applied_mode": {
          "title": "Applied Mode",
          "type": "string"
        },
        "range_enabled": {
          "title": "Range Enabled",
          "type": "boolean"
        },
        "range_fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range Fallback Reason"
        },
        "language_gate": {
          "$ref": "#/$defs/LanguageGate"
        },
        "preferred_artists": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Preferred Artists",
          "type": "array"
        }
      },
      "required": [
        "scoring_version",
        "shelves_version",
        "applied_mode",
        "range_enabled",
        "language_gate"
      ],
      "title": "Algorithm",
      "type": "object"
    },
    "AxisScores": {
      "description": "축별 0~1 백분위. 표시용이 아니라 로그·디버그용.",
      "properties": {
        "ecapa": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ecapa",
          "type": "number"
        },
        "singer_byol": {
          "maximum": 1,
          "minimum": 0,
          "title": "Singer Byol",
          "type": "number"
        },
        "consensus": {
          "maximum": 1,
          "minimum": 0,
          "title": "Consensus",
          "type": "number"
        }
      },
      "required": [
        "ecapa",
        "singer_byol",
        "consensus"
      ],
      "title": "AxisScores",
      "type": "object"
    },
    "LanguageGate": {
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "genres": {
          "items": {
            "type": "string"
          },
          "title": "Genres",
          "type": "array"
        },
        "allowed": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Allowed"
        },
        "excluded_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excluded Count"
        }
      },
      "required": [
        "enabled",
        "genres",
        "allowed"
      ],
      "title": "LanguageGate",
      "type": "object"
    },
    "RangeFit": {
      "additionalProperties": true,
      "description": "음역 적합도 상세 (`vocal-range-keyshift-continuous-v2`). 나머지 서버 필드는 통과시킨다.",
      "properties": {
        "scoringVersion": {
          "title": "Scoringversion",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "centerScore": {
          "maximum": 1,
          "minimum": 0,
          "title": "Centerscore",
          "type": "number"
        },
        "spanFit": {
          "maximum": 1,
          "minimum": 0,
          "title": "Spanfit",
          "type": "number"
        },
        "softFit": {
          "maximum": 1,
          "minimum": 0,
          "title": "Softfit",
          "type": "number"
        },
        "keyShift": {
          "maximum": 5,
          "minimum": -6,
          "title": "Keyshift",
          "type": "integer"
        },
        "songCoreLowMidi": {
          "title": "Songcorelowmidi",
          "type": "integer"
        },
        "songCoreHighMidi": {
          "title": "Songcorehighmidi",
          "type": "integer"
        },
        "catalogProfileReliable": {
          "title": "Catalogprofilereliable",
          "type": "boolean"
        }
      },
      "required": [
        "scoringVersion",
        "score",
        "coverage",
        "centerScore",
        "spanFit",
        "softFit",
        "keyShift",
        "songCoreLowMidi",
        "songCoreHighMidi",
        "catalogProfileReliable"
      ],
      "title": "RangeFit",
      "type": "object"
    },
    "RecommendResult": {
      "additionalProperties": true,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/Algorithm"
        },
        "query": {
          "additionalProperties": true,
          "title": "Query",
          "type": "object"
        },
        "shelves": {
          "items": {
            "$ref": "#/$defs/Shelf"
          },
          "title": "Shelves",
          "type": "array"
        },
        "recommendations": {
          "description": "shelves[0].items 복사본 (호환용)",
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Recommendations",
          "type": "array"
        },
        "catalog_track_count": {
          "title": "Catalog Track Count",
          "type": "integer"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "algorithm",
        "query",
        "shelves",
        "catalog_track_count"
      ],
      "title": "RecommendResult",
      "type": "object"
    },
    "Recommendation": {
      "properties": {
        "position": {
          "description": "섹션 안 위치. 서버가 정한 순서이며 클라이언트는 재정렬하지 않는다",
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "shelf": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "소속 섹션 key (voice | original_key | favorite_artists | challenge | discovery)",
          "title": "Shelf"
        },
        "track_id": {
          "description": "카탈로그 내부 id",
          "title": "Track Id",
          "type": "string"
        },
        "song_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "DB song_id는 UUID 등 불투명 문자열. 이전 숫자 ID 캐시도 읽을 수 있다",
          "title": "Song Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "artist": {
          "title": "Artist",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/TrackMetadata"
        },
        "axis": {
          "anyOf": [
            {
              "enum": [
                "ECAPA",
                "SINGER_BYOL",
                "CONSENSUS"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "음색 섹션(voice)에서만. 두 축 할당 결과",
          "title": "Axis"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "음색 섹션에서 화면에 그대로 표시하는 문구",
          "title": "Label"
        },
        "axis_scores": {
          "anyOf": [
            {
              "$ref": "#/$defs/AxisScores"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "axis_rank": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "후보군 안 축별 순위(1~). 로그용",
          "title": "Axis Rank"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "해당 축의 query 구간 일치율. 로그·진단용",
          "title": "Confidence"
        },
        "timbre_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Timbre Score",
          "type": "number"
        },
        "range_fit": {
          "anyOf": [
            {
              "$ref": "#/$defs/RangeFit"
            },
            {
              "type": "null"
            }
          ],
          "description": "사용자 음역 프로파일이 없거나 신뢰도가 낮으면 null"
        },
        "recommended_key": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": -6,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "반음. range_fit 이 null 이면 null",
          "title": "Recommended Key"
        },
        "final_score": {
          "description": "서버 최종 점수. 클라이언트 계산 금지",
          "maximum": 1,
          "minimum": 0,
          "title": "Final Score",
          "type": "number"
        },
        "metrics": {
          "additionalProperties": true,
          "description": "섹션별 표시 지표 (coverage0, center0, artist_similarity, high_ratio0 …)",
          "title": "Metrics",
          "type": "object"
        },
        "scoring_version": {
          "title": "Scoring Version",
          "type": "string"
        },
        "composition_version": {
          "title": "Composition Version",
          "type": "string"
        }
      },
      "required": [
        "position",
        "track_id",
        "song_id",
        "title",
        "artist",
        "metadata",
        "timbre_score",
        "range_fit",
        "recommended_key",
        "final_score",
        "scoring_version",
        "composition_version"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "Shelf": {
      "additionalProperties": true,
      "description": "추천 섹션 하나. 섹션 간 같은 곡은 없다.",
      "properties": {
        "key": {
          "enum": [
            "voice",
            "original_key",
            "favorite_artists",
            "challenge",
            "discovery"
          ],
          "title": "Key",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "metric": {
          "description": "이 섹션이 어떤 지표로 뽑혔는지 한 줄 (화면 부제로 그대로 사용 가능)",
          "title": "Metric",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "key",
        "title",
        "metric",
        "items"
      ],
      "title": "Shelf",
      "type": "object"
    },
    "TrackMetadata": {
      "properties": {
        "album_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Album Name"
        },
        "display_image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Image Url"
        },
        "genres": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Genres",
          "type": "array"
        },
        "language": {
          "anyOf": [
            {
              "enum": [
                "ko",
                "en",
                "jp"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "release_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Date"
        },
        "tj_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tj Id"
        },
        "artist_gender": {
          "anyOf": [
            {
              "enum": [
                "female",
                "male",
                "mixed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "성별 필터용. 카탈로그에 아직 데이터 없음 → null",
          "title": "Artist Gender"
        }
      },
      "title": "TrackMetadata",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "POST /recommendations(202) 와 GET /recommendations/{id} 의 응답.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "processing",
        "complete",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "progress": {
      "maximum": 100,
      "minimum": 0,
      "title": "Progress",
      "type": "integer"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "mode": {
      "title": "Mode",
      "type": "string"
    },
    "genres": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Genres",
      "type": "array"
    },
    "preferred_artists": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Preferred Artists",
      "type": "array"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecommendResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "id",
    "status",
    "progress",
    "message",
    "mode"
  ],
  "title": "Job",
  "type": "object"
}
